   allow update: if (admin(resource.data) && validCommunity(request.resource.data) && request.resource.data.owner==resource.data.owner) || (signedIn() && request.auth.uid in resource.data.members && request.auth.uid!=resource.data.owner && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins']) && request.resource.data.members==resource.data.members.removeAll([request.auth.uid]) && request.resource.data.admins==resource.data.admins.removeAll([request.auth.uid]));
   allow delete: if signedIn() && resource.data.owner==request.auth.uid;
  }
  match /channelDirectory/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.owner==request.auth.uid && validDirectory(request.resource.data) && getAfter(/databases/$(database)/documents/chats/$(id)).data.kind=='channel' && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(id)).data.admins;
   allow update: if signedIn() && resource.data.owner==request.auth.uid && request.resource.data.owner==resource.data.owner && validDirectory(request.resource.data);
   allow delete: if signedIn() && resource.data.owner==request.auth.uid;
  }
  match /statuses/{id} {
   allow read: if operator();allow delete: if cleanupDue(resource.data.createdAt);
   allow get: if signedIn() && (resource.data.owner==request.auth.uid || (request.auth.uid in resource.data.get('audienceIds',[]) && resource.data.expiresAt>request.time.toMillis()));
   allow list: if signedIn() && (resource.data.owner==request.auth.uid || request.auth.uid in resource.data.get('audienceIds',[]));
   allow create: if signedIn() && request.resource.data.id==id && request.resource.data.owner==request.auth.uid && request.resource.data.audienceIds is list && request.resource.data.audienceIds.size()<=500 && request.resource.data.text is string && request.resource.data.text.size()<=1000 && request.resource.data.get('fileUrl','') is string && request.resource.data.get('fileSize',0)<=104857600 && request.resource.data.expiresAt<=request.time.toMillis()+86460000 && request.resource.data.expiresAt>request.time.toMillis();
   allow update: if signedIn() && resource.data.owner==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audienceIds']) && request.resource.data.audienceIds is list && request.resource.data.audienceIds.size()<=500;
   allow delete: if signedIn() && resource.data.owner==request.auth.uid;
   match /reactions/{uid}{
    allow read: if operator();allow delete: if cleanupDue(get(/databases/$(database)/documents/statuses/$(id)).data.createdAt);
    function status(){return get(/databases/$(database)/documents/statuses/$(id)).data;}
    allow read: if signedIn() && (status().owner==request.auth.uid || (uid==request.auth.uid && request.auth.uid in status().audienceIds));
    allow create,update: if signedIn() && uid==request.auth.uid && request.auth.uid in status().audienceIds && status().expiresAt>request.time.toMillis() && request.resource.data.keys().hasOnly(['emoji','at']) && request.resource.data.emoji is string && request.resource.data.emoji.size()<=32 && request.resource.data.at is number;
    allow delete: if signedIn() && (uid==request.auth.uid || status().owner==request.auth.uid);
   }
  }
  match /publicConfig/availability {
   allow get: if true;
   allow create,update: if operator()
    && request.resource.data.keys().hasOnly(['maintenance','updatedAt'])
    && request.resource.data.maintenance is bool && request.resource.data.updatedAt==request.time;
  }
  match /publicConfig/cleanup {allow read: if signedIn();allow create,update: if operator() && request.resource.data.keys().hasOnly(['enabled','execution','firstDueAt','nextDueAt','warningDays','status','leaseUntil','runId','lastCompletedAt','counts','manualCutoff']) && request.resource.data.enabled is bool && request.resource.data.execution=='browser' && request.resource.data.nextDueAt is number && request.resource.data.warningDays==3 && request.resource.data.status in ['scheduled','running','error'] && (!('manualCutoff' in request.resource.data) || (cutoffMillis(request.resource.data.manualCutoff)>0 && cutoffMillis(request.resource.data.manualCutoff)<=request.time.toMillis() && request.resource.data.status=='running' && request.resource.data.leaseUntil is number && request.resource.data.leaseUntil>request.time.toMillis() && request.resource.data.leaseUntil<=request.time.toMillis()+360000));allow delete: if false;}
  match /dashboardEdits/{id} {
   allow read: if operator();
   allow create: if operator() && request.resource.data.keys().hasOnly(['actor','chatId','messageId','senderId','before','after','at'])
    && request.resource.data.actor==request.auth.uid && request.resource.data.at==request.time
    && request.resource.data.chatId is string && request.resource.data.messageId is string
    && request.resource.data.before is string && request.resource.data.after is string
    && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.content==request.resource.data.before
    && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.senderId==request.resource.data.senderId
    && getAfter(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.adminEditId==id
    && getAfter(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.content==request.resource.data.after;
   allow update,delete: if false;
  }
  match /dashboardActions/{id} {
   allow read: if operator();
   allow create: if operator() && request.resource.data.keys().hasOnly(['actor','target','operation','before','after','at'])
    && request.resource.data.actor==request.auth.uid && request.resource.data.at==request.time
    && request.resource.data.operation in ['create','update','delete']
    && request.resource.data.target is path
    && (exists(request.resource.data.target) ? request.resource.data.before==get(request.resource.data.target).data : request.resource.data.before==null)
    && (existsAfter(request.resource.data.target) ? request.resource.data.after==getAfter(request.resource.data.target).data : request.resource.data.after==null);
   allow update,delete: if false;
  }
  match /assistantOperations/{pointer=**} {
   allow read: if operator();
   allow create,update: if operator() && request.resource.data.keys().hasOnly(['actor','id','at'])
    && request.resource.data.actor==request.auth.uid && request.resource.data.at==request.time
    && getAfter(/databases/$(database)/documents/dashboardActions/$(request.resource.data.id)).data.actor==request.auth.uid
    && getAfter(/databases/$(database)/documents/dashboardActions/$(request.resource.data.id)).data.at==request.time;
   allow delete: if false;
  }
  match /{area}/{target=**} {
   function assistantWrite(){
    let pointer=getAfter(/databases/$(database)/documents/assistantOperations/$(area)/$(target)/latest).data;
    let action=getAfter(/databases/$(database)/documents/dashboardActions/$(pointer.id)).data;
    return pointer.actor==request.auth.uid && pointer.at==request.time
     && action.actor==request.auth.uid && action.at==request.time && action.target==request.path
     && action.operation==request.method
     && (resource==null ? action.before==null : action.before==resource.data)
     && (request.resource==null ? action.after==null : action.after==request.resource.data);
   }
   allow read: if operator();
   allow write: if operator() && !(area in ['dashboardAdmins','dashboardActions','dashboardEdits','assistantOperations','dashboardSecurity','users','usernames','nexusNumbers','nexusNumberReservations','contactCodes','deletedAccounts','moderatedUsers','moderatedChats','assistantAdminJobs','assistantAdminAudit',"mediaFiles","clientMedia","calls","callRooms","signals","incoming","presence","presenceSessions","presenceLastSeen","presencePrivacy"])
    && request.path!=/databases/$(database)/documents/publicConfig/cleanup
    && request.path!=/databases/$(database)/documents/publicConfig/assistantAdmin && assistantWrite();
  }

 }
}
