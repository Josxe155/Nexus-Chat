{
  "name": "nexus-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.cjs",
    "lint": "tsc --noEmit",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build:hosting": "node scripts/build-hosting.cjs",
    "setup": "node scripts/setup-services.cjs",
    "postinstall": "node scripts/setup-services.cjs && node scripts/clean-tts.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "test:dashboard-ai": "node --import tsx scripts/dashboard-ai.test.ts",
    "test:dashboard-access": "node scripts/dashboard-read-access.test.cjs",
    "test:dashboard-command": "node scripts/dashboard-command.test.cjs",
    "test:rich-text": "node --import tsx scripts/rich-text.test.ts",
    "test:dashboard-actions": "node scripts/dashboard-actions.test.cjs",
    "test:dashboard-owner": "node --import tsx scripts/dashboard-owner.test.ts",
    "test:account-references": "node --import tsx scripts/account-references.test.ts",
    "test:google-contacts:preference": "node --import tsx scripts/google-contacts-preference.test.ts",
    "test:google-contacts:privacy": "node scripts/google-contacts-privacy-emulator.test.cjs",
    "test:google-contacts": "node --import tsx scripts/google-contacts.test.ts",
    "test:contacts": "node --import tsx scripts/contacts.test.ts",
    "test:cleanup": "node --import tsx scripts/cleanup.test.ts",
    "test:cleanup:emulators": "node scripts/cleanup-emulator.test.cjs",
    "test:contact-menu": "node --import tsx scripts/contact-menu.test.ts",
    "test:contact-menu:emulators": "node scripts/contact-menu-emulator.test.cjs",
    "test:references": "node --import tsx scripts/reference-november.test.ts",
    "test:channels:emulators": "node scripts/channels-emulator.test.cjs",
    "test:message-policy": "node --import tsx scripts/message-policy.test.ts",
    "test:poll-privacy": "node --import tsx scripts/poll-privacy.test.ts",
    "test:message-policy:emulators": "node scripts/message-policy-emulator.test.cjs",
    "test:anonymous-polls:emulators": "node scripts/anonymous-polls-emulator.test.cjs",
    "test:image-clipboard": "node --import tsx scripts/image-clipboard.test.ts",
    "test:recording-camera": "node --import tsx scripts/recording-camera.test.ts",
    "test:guest-identity": "node --import tsx scripts/guest-identity.test.ts",
    "test:guest:emulators": "node scripts/guest-account-emulator.test.cjs",
    "test:assistant-media": "node --import tsx scripts/assistant-media.test.ts",
    "test:assistant-capabilities:emulators": "node scripts/assistant-capabilities-emulator.test.cjs",
    "test:assistant-confirmation": "node --import tsx scripts/assistant-confirmation.test.ts",
    "test:kokoro-speech": "npm run test:speech",
    "test:voice-download": "node --import tsx scripts/voice-download.test.ts",
    "test:call-audio-output": "node --import tsx scripts/call-audio-output.test.ts",
    "test:background-notifications": "node scripts/background-notifications.test.cjs",
    "test:voice-media-session": "node --import tsx scripts/voice-media-session.test.ts",
    "test:security:emulators": "node scripts/security-audit-emulator.test.cjs",
    "test:massive": "node --import tsx scripts/massive-update.test.ts",
    "test:retention:emulators": "node scripts/massive-retention-emulator.test.cjs && node scripts/massive-realtime-emulator.test.cjs",
    "test:country": "node --import tsx scripts/country-location.test.ts",
    "test:country:emulators": "node scripts/country-number-emulator.test.cjs",
    "test:speech": "node --import tsx scripts/speech.test.ts",
    "test:google-contacts:apps-script": "node scripts/google-contacts-apps-script.test.cjs",
    "test:google-contacts:bridge": "node --import tsx scripts/google-contacts-bridge.test.ts",
    "test:history:emulators": "node scripts/history-emulator.test.cjs",
    "test:history": "node --import tsx scripts/paged-messages.test.ts",
    "test:browser-permissions": "node --import tsx scripts/browser-permissions.test.ts"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
